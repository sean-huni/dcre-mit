<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- man_init_verdict: MIT single writer (R-04, AIS ais_verdict pattern). One
         durable init verdict row per instruction record keyed on the FULL business
         identity (arrival_id, sequence): the UNIQUE lets the guarded INSERT ... ON
         CONFLICT DO NOTHING make a resume a zero-duplicate no-op and keeps the verdict
         immutable (never UPSERT on the PK; CRDB resolves UPSERT on PK only,
         persistence.md). action is EXISTS or CREATED (R-21: code values, never enum
         ordinals), derived from whether the idempotent creditor-account mint actually
         inserted. MIT reads the mrr-owned spine (mandate_request_entry) and mints into
         the shared dcre_man account master (000-man-core-bootstrap.xml); it OWNS this
         table and the spine_state -> INITIALIZED transition (ruling note 2). No
         projection writes: MSR is the sole writer of the mandate FSM. -->
    <changeSet id="mit-001-man-init-verdict" author="dcre">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="man_init_verdict"/></not>
        </preConditions>
        <createTable tableName="man_init_verdict">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="arrival_id" type="UUID"><constraints nullable="false"/></column>
            <column name="sequence" type="INT"><constraints nullable="false"/></column>
            <column name="action" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="man_init_verdict" columnNames="arrival_id, sequence"
                             constraintName="uq_man_init_verdict_arrival_sequence"/>
    </changeSet>

</databaseChangeLog>
